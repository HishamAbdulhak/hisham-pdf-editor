{
  "name": "hisham-pdf-editor",
  "productName": "Hisham's PDF Editor",
  "version": "1.0.0",
  "description": "Free, offline PDF editor: edit text, fill forms, sign, OCR, and organise pages.",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js && node scripts/serve.js",
    "watch": "node scripts/build.js --watch",
    "start": "node scripts/build.js && electron .",
    "sample": "node scripts/make-sample.js",
    "icon": "node scripts/make-icon.js",
    "dist": "node scripts/make-icon.js && node scripts/build.js && electron-builder --win",
    "html": "node scripts/build.js && node scripts/build-html.js",
    "dist:temp": "node scripts/release.js"
  },
  "author": "Hisham",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/cairo": "^0.4.2",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "bidi-js": "^1.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.hisham.pdfeditor",
    "productName": "Hisham's PDF Editor",
    "copyright": "Free to share",
    "files": [
      "electron/**",
      "out/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "executableName": "HishamsPDFEditor",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Hishams-PDF-Editor-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hisham's PDF Editor",
      "artifactName": "Hishams-PDF-Editor-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ]
  }
}
